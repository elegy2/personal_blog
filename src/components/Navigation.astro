<div class="nav-links">
  <a href="/">首页</a>
  <a href="/about/">关于</a>
  <a href="/blog/">博客</a>
  <a href="/tags/">标签</a>
  <a href="/show/">展示</a>
  <a href="/tarot/">塔罗牌</a>
</div>

<style>
  .nav-links {
    display: flex;
    justify-content: flex-end; /* 靠右 */
    gap: 1.5rem;
    padding: 0.5rem 1rem;
  }

  .nav-links a {
    position: relative;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    color: #000000;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  /* hover 文字颜色 + 背景 */
  .nav-links a:hover {
    color: #5c7cfa;
    background: rgba(92, 124, 250, 0.12); /* 浅蓝透明背景 */
  }

  /* 下划线动画 */
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 2px;
    background-color: #5c7cfa;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* 深色模式下字体白色 */
  html.dark .nav-links a {
    color: #ffffff;
  }

  /* ===== 移动端：默认隐藏，点击汉堡展开为下拉菜单 ===== */
  @media screen and (max-width: 768px) {
    .nav-links {
      display: none;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.25rem;
      padding: 0.5rem;
      margin-top: 0.5rem;
      width: 100%;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      animation: navDrop 0.25s ease;
    }

    .nav-links.expanded {
      display: flex;
    }

    .nav-links a {
      display: block;
      width: 100%;
      text-align: center;
      font-size: 1.05rem;
      padding: 0.85rem 1rem;
      border-radius: 10px;
    }

    /* 移动端去掉下划线动画，改用整块高亮 */
    .nav-links a::after {
      display: none;
    }

    html.dark .nav-links {
      background: rgba(20, 18, 50, 0.95);
    }
  }

  @keyframes navDrop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
