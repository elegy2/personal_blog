---
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
import Hamburger from "./Hamburger.astro";
---

<header class="site-header">
  <nav class="nav-bar">
    <div class="nav-left">
      <Hamburger />
      <ThemeIcon />
    </div>
    <Navigation />
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    top: 0;
    left: 0;
    z-index: 100;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between; /* 左右分布 */
    flex-wrap: wrap;
    padding: 0.5rem 1.5rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media screen and (max-width: 768px) {
    .nav-bar {
      padding: 0.5rem 1rem;
    }
  }
</style>
